{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_cards.issued.title' | t }} | {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="stripe-bg">
    <main class="section">
      <div class="container container--narrow text-center">
        <p class="script" style="font-size:3rem;color:var(--c-ink);">{{ shop.name }}</p>
        <h1 class="display" style="font-size:2rem;margin-top:12px;">Gift card</h1>
        <p style="margin-top:18px;font-size:2rem;color:var(--c-rose-deep);">{{ gift_card.balance | money }}</p>
        {{ gift_card.qr_identifier }}
        <p style="margin-top:18px;letter-spacing:.18em;font-weight:700;">{{ gift_card.code | format_code }}</p>
        <p style="margin-top:22px;">
          <a class="btn btn--primary" href="{{ shop.url }}">Redeem at {{ shop.name }}</a>
        </p>
      </div>
    </main>
  </body>
</html>
