<div class="account stripe-bg section">
  <div class="container container--narrow">
    <h1 class="account__title script">Create account</h1>
    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="RegFirst">First name</label>
        <input class="input" id="RegFirst" type="text" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegLast">Last name</label>
        <input class="input" id="RegLast" type="text" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegEmail">Email</label>
        <input class="input" id="RegEmail" type="email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="RegPassword">Password</label>
        <input class="input" id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--wide" style="margin-top:20px;">Create account</button>
    {%- endform -%}
    <p class="account__link">Already have an account? <a href="{{ routes.account_login_url }}">Log in</a></p>
  </div>
</div>
