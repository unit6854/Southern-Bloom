<div class="account stripe-bg section">
  <div class="container container--narrow">
    <h1 class="account__title script">Reset password</h1>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="ResetPassword">New password</label>
        <input class="input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetConfirm">Confirm password</label>
        <input class="input" id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--wide" style="margin-top:20px;">Reset password</button>
    {%- endform -%}
  </div>
</div>
