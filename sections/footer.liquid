<footer class="footer" style="--footer-bg: {{ section.settings.bg_color }}; --footer-bar-bg: {{ section.settings.bar_color }};">

  <div class="footer__main stripe-bg">
    <div class="container container--wide">
      <div class="footer__grid">

        {%- comment -%} Logo mark {%- endcomment -%}
        {%- if section.settings.show_logo -%}
          <div class="footer__brand">
            {%- if settings.logo_mark != blank -%}
              {{
                settings.logo_mark
                | image_url: width: 500
                | image_tag:
                  class: 'footer__logo',
                  widths: '160,240,320,500',
                  sizes: '(min-width: 990px) 160px, 130px',
                  alt: shop.name,
                  loading: 'lazy'
              }}
            {%- else -%}
              <img
                src="{{ 'logo-mark.webp' | asset_url }}"
                alt="{{ shop.name }}"
                class="footer__logo"
                width="320" height="320"
                loading="lazy">
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Newsletter {%- endcomment -%}
        <div class="footer__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="footer__heading">
              {{ section.settings.newsletter_heading }}
              <span class="footer__heading-heart">{% render 'icon', name: 'heart' %}</span>
            </h2>
          {%- endif -%}

          {%- if section.settings.newsletter_text != blank -%}
            <div class="footer__text rte">{{ section.settings.newsletter_text }}</div>
          {%- endif -%}

          {%- form 'customer', class: 'newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.email_label' | t }}</label>
            <div class="newsletter-form__row">
              <input
                id="NewsletterEmail"
                class="newsletter-form__input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email' }}"
                autocomplete="email"
                required
              >
              <button class="newsletter-form__button" type="submit">
                <span>{{ section.settings.newsletter_button | default: 'Subscribe' }}</span>
                {% render 'icon', name: 'arrow-right', class: 'btn__arrow' %}
              </button>
            </div>

            {%- if form.errors -%}
              <p class="newsletter-form__msg newsletter-form__msg--error">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="newsletter-form__msg newsletter-form__msg--success">
                {{ 'newsletter.success' | t }}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>

        {%- comment -%} Social {%- endcomment -%}
        <div class="footer__social-wrap">
          {% render 'social-icons', class: 'footer__social' %}
        </div>
      </div>

      {%- comment -%} Optional link columns {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="footer__columns">
          {%- for block in section.blocks -%}
            <div class="footer__column" {{ block.shopify_attributes }}>
              {%- case block.type -%}

                {%- when 'menu' -%}
                  {%- if block.settings.heading != blank -%}
                    <h3 class="footer__col-heading">{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  <ul class="footer__col-list">
                    {%- for link in linklists[block.settings.menu].links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>

                {%- when 'contact' -%}
                  {%- if block.settings.heading != blank -%}
                    <h3 class="footer__col-heading">{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  <ul class="footer__col-list footer__col-list--contact">
                    {%- if settings.contact_phone != blank -%}
                      {%- assign tel = settings.contact_phone | strip | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' -%}
                      <li>{% render 'icon', name: 'phone' %}<a href="tel:{{ tel }}">{{ settings.contact_phone }}</a></li>
                    {%- endif -%}
                    {%- if settings.contact_email != blank -%}
                      <li>{% render 'icon', name: 'mail' %}<a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
                    {%- endif -%}
                    {%- if settings.service_area != blank -%}
                      <li>{% render 'icon', name: 'pin' %}<span>{{ settings.service_area }}</span></li>
                    {%- endif -%}
                  </ul>

                {%- when 'text' -%}
                  {%- if block.settings.heading != blank -%}
                    <h3 class="footer__col-heading">{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  <div class="rte footer__col-text">{{ block.settings.text }}</div>

              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Bottom bar {%- endcomment -%}
  <div class="footer__bar">
    <div class="container container--wide footer__bar-inner">
      <p class="footer__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        {%- if section.settings.tagline != blank %} | {{ section.settings.tagline }}{% endif -%}
        {%- if section.settings.show_bar_heart -%}
          <span class="footer__bar-heart">{% render 'icon', name: 'heart' %}</span>
        {%- endif -%}
      </p>

      {%- if section.settings.policy_menu != blank -%}
        <ul class="footer__policies">
          {%- for link in linklists[section.settings.policy_menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show circular logo",
      "default": true
    },
    { "type": "header", "content": "Newsletter" },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Let's stay in touch"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Text",
      "default": "<p>Be the first to know about new designs, special offers, and sweet inspiration!</p>"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button label",
      "default": "Subscribe"
    },
    { "type": "header", "content": "Bottom bar" },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Made with love in the South"
    },
    {
      "type": "checkbox",
      "id": "show_bar_heart",
      "label": "Show heart in bottom bar",
      "default": true
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policy menu",
      "default": "footer"
    },
    { "type": "header", "content": "Colours" },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#fdf6f6"
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "Bottom bar",
      "default": "#d5738a"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Creating beautiful custom sugar cookies that bring joy, celebrate milestones, and help life's sweetest moments bloom.</p>"
        }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
