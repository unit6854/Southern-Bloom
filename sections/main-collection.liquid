<div class="collection stripe-bg section{% if section.settings.tight_top %} section--tight-top{% endif %}">
  <div class="container container--wide">

    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="collection__intro rte">{{ collection.description }}</div>
    {%- endif -%}

    <div class="collection__toolbar">
      <p class="collection__count">
        {{ 'collections.general.items_with_count' | t: count: collection.products_count }}
      </p>

      {%- if section.settings.show_sort -%}
        <form class="collection__sort" method="get">
          <label class="visually-hidden" for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
          <select id="SortBy" name="sort_by" class="select select--sm" onchange="this.form.submit()">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="product-grid" style="--grid-cols: {{ section.settings.columns }};">
          {%- for product in collection.products -%}
            <li class="product-grid__item">
              {% render 'product-card', product: product %}
            </li>
          {%- endfor -%}
        </ul>

        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="collection__empty">
          <p>{{ 'collections.general.no_matches' | t }}</p>
          <a href="{{ settings.order_form_url }}" class="btn btn--primary">
            {{ 'products.product.custom_order_link' | t }}
            {% render 'icon', name: 'arrow-right', class: 'btn__arrow' %}
          </a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "class": "collection-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "tight_top",
      "label": "Reduce space above the grid",
      "default": false,
      "info": "Turn on when the banner above is set to Compact."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort dropdown",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
