{%- liquid
  assign mobile_img = section.settings.mobile_image | default: section.settings.image
-%}

<div
  class="cta-banner stripe-bg"
  style="--cta-min-height: {{ section.settings.min_height }}vw; --cta-scrim: {{ section.settings.scrim | divided_by: 100.0 }};"
>
  <div class="cta-banner__media media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if mobile_img != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_img | image_url: width: 750 }} 750w, {{ mobile_img | image_url: width: 1100 }} 1100w"
            sizes="100vw">
        {%- endif -%}
        <source
          srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1800 }} 1800w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
          sizes="100vw">
        <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="" loading="lazy">
      </picture>
    {%- else -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ 'cta-bar-mobile.webp' | asset_url }}">
        <img src="{{ 'cta-bar.webp' | asset_url }}" alt="" width="1952" height="544" loading="lazy">
      </picture>
    {%- endif -%}
  </div>

  {%- if section.settings.scrim > 0 -%}
    <span class="cta-banner__scrim" aria-hidden="true"></span>
  {%- endif -%}

  <div class="cta-banner__inner container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow cta-banner__eyebrow">
        {{ section.settings.eyebrow }}
        {%- if section.settings.show_heart -%}<span class="heart">{% render 'icon', name: 'heart' %}</span>{%- endif -%}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="cta-banner__heading display">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="cta-banner__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      {%- assign cta_link = section.settings.button_link | default: settings.order_form_url -%}
      <a href="{{ cta_link }}" class="btn btn--primary cta-banner__button">
        {{ section.settings.button_label }}
        {% render 'icon', name: 'arrow-right', class: 'btn__arrow' %}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Call to action banner",
  "tag": "section",
  "class": "cta-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Let's make something sweet"
    },
    {
      "type": "checkbox",
      "id": "show_heart",
      "label": "Show heart after label",
      "default": true
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your celebration deserves cookies as beautiful as the moment."
    },
    { "type": "richtext", "id": "text", "label": "Body text" },
    { "type": "header", "content": "Button" },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Start your order"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link",
      "info": "Leave empty to use the custom order form URL from Theme settings."
    },
    { "type": "header", "content": "Background photo" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "A wide banner with clear space in the middle works best. Leave empty to use the supplied bar."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Photo — mobile",
      "info": "Optional. Falls back to the photo above."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Height (desktop)",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "vw",
      "default": 28
    },
    {
      "type": "range",
      "id": "scrim",
      "label": "Fade behind the text",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Raise this if a busier photo makes the text hard to read."
    }
  ],
  "presets": [{ "name": "Call to action banner" }]
}
{% endschema %}
