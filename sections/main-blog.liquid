<div class="blog stripe-bg section">
  <div class="container container--wide">
    <h1 class="blog__title script">{{ blog.title }}</h1>

    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="blog__grid">
          {%- for article in blog.articles -%}
            <li>
              <a class="article-card" href="{{ article.url }}">
                {%- if article.image -%}
                  <span class="article-card__media media">
                    {{ article.image | image_url: width: 800 | image_tag: widths: '300,500,800', sizes: '(min-width: 750px) 32vw, 92vw', alt: article.title, loading: 'lazy' }}
                  </span>
                {%- endif -%}
                <span class="article-card__body">
                  <span class="article-card__date">{{ article.published_at | date: '%B %-d, %Y' }}</span>
                  <span class="article-card__title">{{ article.title }}</span>
                  <span class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</span>
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p class="text-center">{{ 'blog.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{ "name": "Blog posts", "tag": "section", "class": "blog-section", "settings": [] }
{% endschema %}
