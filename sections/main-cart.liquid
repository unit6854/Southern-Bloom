<div class="cart-page stripe-bg section">
  <div class="container">
    <h1 class="cart-page__title script">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-page__form">
        <ul class="cart-page__items">
          {%- for item in cart.items -%}
            <li class="cart-line cart-line--page">
              <a class="cart-line__media media" href="{{ item.url }}">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 300 | image_tag: alt: item.title, loading: 'lazy' }}
                {%- endif -%}
              </a>

              <div class="cart-line__info">
                <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-line__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-line__price">{{ item.final_line_price | money }}</p>

                <div class="cart-line__actions">
                  <div class="qty" data-qty>
                    <button type="button" data-qty-change="-1" aria-label="{{ 'products.product.decrease' | t }}">&minus;</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'cart.general.quantity' | t }}">
                    <button type="button" data-qty-change="1" aria-label="{{ 'products.product.increase' | t }}">+</button>
                  </div>
                  <a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.general.remove' | t }}</a>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart-page__foot">
          {%- if settings.show_cart_note -%}
            <div class="cart-page__note">
              <label class="field__label" for="CartNote">{{ 'cart.general.note' | t }}</label>
              <textarea id="CartNote" name="note" class="textarea" placeholder="{{ 'cart.general.note_placeholder' | t }}">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <div class="cart-page__summary">
            <div class="cart-page__subtotal">
              <span>{{ 'cart.general.subtotal' | t }}</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>
            <p class="cart-page__tax">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
            <button type="submit" name="update" class="btn btn--outline btn--wide">{{ 'cart.general.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--primary btn--wide cart-page__checkout">
              {{ 'cart.general.checkout' | t }}
              {% render 'icon', name: 'arrow-right', class: 'btn__arrow' %}
            </button>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart-page__empty">
        <span class="cart-page__empty-icon">{% render 'icon', name: 'cookie' %}</span>
        <p>{{ 'cart.general.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">
          {{ 'cart.general.continue_shopping' | t }}
          {% render 'icon', name: 'arrow-right', class: 'btn__arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "cart-page-section",
  "settings": []
}
{% endschema %}
