{%- liquid
  assign coll = collections[section.settings.collection]
  assign items = coll.products
-%}

<div class="featured stripe-bg section section--tight">
  <div class="container container--wide">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-head featured__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">
            {{ section.settings.eyebrow }}
            {%- if section.settings.show_heart -%}<span class="heart">{% render 'icon', name: 'heart' %}</span>{%- endif -%}
          </span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-head__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if items.size > 0 -%}
      <ul class="product-grid" style="--grid-cols: {{ section.settings.columns }};">
        {%- for product in items limit: section.settings.limit -%}
          <li class="product-grid__item">{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="featured__cta">
        <a href="{{ section.settings.button_link | default: coll.url | default: routes.all_products_collection_url }}" class="btn btn--primary">
          {{ section.settings.button_label }}
          {% render 'icon', name: 'arrow-right', class: 'btn__arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "featured-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Fresh from the kitchen" },
    { "type": "checkbox", "id": "show_heart", "label": "Show heart after label", "default": true },
    { "type": "text", "id": "heading", "label": "Heading (script)", "default": "Shop Favourites" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
