<div class="gallery-grid stripe-bg section{% if section.settings.tight_top %} gallery-grid--tight-top{% endif %}">
  <div class="container container--wide">

    {%- if section.settings.heading != blank -%}
      <div class="section-head gallery-grid__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="gallery-grid__list" style="--gallery-cols: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign cat = block.settings.category | handleize
            assign alt = block.settings.caption | default: block.settings.category | default: 'Custom decorated sugar cookies'
            assign fallback_url = block.settings.fallback_asset | asset_url
            if block.settings.image != blank
              assign full_url = block.settings.image | image_url: width: 1600
              assign thumb_url = block.settings.image | image_url: width: 800
            else
              assign full_url = fallback_url
              assign thumb_url = fallback_url
            endif
          -%}
          <li class="gallery-item" data-gallery-item data-category="{{ cat }}" {{ block.shopify_attributes }}>
            <button
              class="gallery-item__button"
              type="button"
              data-lightbox="{{ full_url }}"
              data-alt="{{ alt | escape }}"
              data-caption="{{ block.settings.caption | escape }}"
              aria-label="{{ alt | escape }}"
            >
              <span class="gallery-item__media media">
                <img
                  src="{{ thumb_url }}"
                  alt="{{ alt | escape }}"
                  loading="lazy"
                  width="800" height="1000">
              </span>
              {%- if block.settings.caption != blank and section.settings.show_captions -%}
                <span class="gallery-item__caption">{{ block.settings.caption }}</span>
              {%- endif -%}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="gallery-grid__empty">{{ 'gallery.empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Gallery grid",
  "tag": "section",
  "class": "gallery-grid-section",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading (script)" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_captions",
      "label": "Show captions under photos",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "tight_top",
      "label": "Reduce space above",
      "default": false,
      "info": "Turn on when this grid follows another gallery section."
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "info": "Must match a pill in the Gallery filter section, e.g. Birthdays.",
          "default": "And more"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Bundled photo filename",
          "info": "Advanced. Used only while no photo is chosen above."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery grid",
      "blocks": [{ "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }]
    }
  ]
}
{% endschema %}
