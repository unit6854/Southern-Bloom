<div class="page stripe-bg section">
  <div class="container container--narrow">
    {%- if section.settings.show_title -%}
      <h1 class="page__title script">{{ page.title }}</h1>
    {%- endif -%}
    <div class="page__content rte">{{ page.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Page content",
  "tag": "section",
  "class": "page-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    }
  ]
}
{% endschema %}
