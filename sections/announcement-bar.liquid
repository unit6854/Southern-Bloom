{%- liquid
  assign bg = section.settings.bg_color | default: settings.color_announcement
  assign fg = section.settings.text_color | default: '#ffffff'
-%}

{%- if section.blocks.size > 0 -%}
  <div
    class="announcement"
    style="--announce-bg: {{ bg }}; --announce-fg: {{ fg }};"
    {% if section.blocks.size > 1 %}data-announcement data-speed="{{ section.settings.rotate_speed }}"{% endif %}
  >
    <div class="announcement__viewport">
      {%- for block in section.blocks -%}
        <div
          class="announcement__item{% if forloop.first %} is-active{% endif %}"
          {{ block.shopify_attributes }}
          role="region"
          aria-roledescription="announcement"
        >
          {%- if block.settings.link != blank -%}<a class="announcement__link" href="{{ block.settings.link }}">{%- endif -%}
            <span class="announcement__text">
              {{- block.settings.text -}}
              {%- if block.settings.show_heart -%}
                <span class="announcement__heart">{% render 'icon', name: 'heart' %}</span>
              {%- endif -%}
            </span>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "announcement-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#da90a1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "rotate_speed",
      "label": "Seconds between messages",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "Only applies when there is more than one message."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Handcrafted cookies. Made with love. Delivered with joy."
        },
        {
          "type": "checkbox",
          "id": "show_heart",
          "label": "Show heart",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "message" }]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
