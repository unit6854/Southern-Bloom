<div class="password stripe-bg">
  <div class="container container--narrow password__inner">
    {%- if settings.logo_mark != blank -%}
      {{ settings.logo_mark | image_url: width: 400 | image_tag: class: 'password__logo', alt: shop.name, loading: 'eager' }}
    {%- else -%}
      <img class="password__logo" src="{{ 'logo-mark.webp' | asset_url }}" alt="{{ shop.name }}" width="320" height="320">
    {%- endif -%}

    <h1 class="password__title script">{{ section.settings.heading | default: shop.name }}</h1>

    {%- if section.settings.text != blank -%}
      <div class="password__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="password__forms">
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error">{{ form.errors.messages.form }}</p>
        {%- endif -%}
        <label class="visually-hidden" for="StorefrontPassword">{{ 'password.password_label' | t }}</label>
        <div class="newsletter-form__row">
          <input class="newsletter-form__input" id="StorefrontPassword" type="password" name="password" placeholder="{{ 'password.password_placeholder' | t }}">
          <button type="submit" class="newsletter-form__button"><span>{{ 'password.enter' | t }}</span></button>
        </div>
      {%- endform -%}

      {%- if section.settings.show_newsletter -%}
        <p class="password__note">{{ section.settings.newsletter_text }}</p>
        {%- form 'customer', class: 'password__form' -%}
          <input type="hidden" name="contact[tags]" value="prelaunch">
          <label class="visually-hidden" for="PasswordEmail">{{ 'password.email_label' | t }}</label>
          <div class="newsletter-form__row">
            <input class="newsletter-form__input" id="PasswordEmail" type="email" name="contact[email]" placeholder="{{ 'password.email_placeholder' | t }}" required>
            <button type="submit" class="newsletter-form__button"><span>{{ 'password.notify' | t }}</span></button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="newsletter-form__msg newsletter-form__msg--success">{{ 'newsletter.success' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>

    {% render 'social-icons', class: 'password__social' %}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "password-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Something sweet is on the way. Check back soon!</p>"
    },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Signup prompt",
      "default": "Be the first to know when we open."
    }
  ]
}
{% endschema %}
