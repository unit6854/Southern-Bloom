<div class="features stripe-bg{% if section.settings.bg == 'alt' %} stripe-bg--alt{% endif %} section section--tight">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-head features__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">
            {{ section.settings.eyebrow }}
            {%- if section.settings.show_heart -%}<span class="heart">{% render 'icon', name: 'heart' %}</span>{%- endif -%}
          </span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-head__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="features__list" style="--features-count: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          <li class="feature" {{ block.shopify_attributes }}>
            {%- if section.settings.show_numbers -%}
              <span class="feature__number">{{ forloop.index }}</span>
            {%- else -%}
              <span class="feature__icon">{% render 'icon', name: block.settings.icon, class: 'occasion-icon' %}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="feature__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="feature__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Feature columns",
  "tag": "section",
  "class": "features-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "checkbox", "id": "show_heart", "label": "Show heart after label", "default": true },
    { "type": "text", "id": "heading", "label": "Heading (script)" },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show step numbers instead of icons",
      "default": false
    },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "alt", "label": "Alternate background" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "cookie", "label": "Cookie" },
            { "value": "heart-line", "label": "Heart" },
            { "value": "cake", "label": "Cake" },
            { "value": "onesie", "label": "Onesie" },
            { "value": "rings", "label": "Rings" },
            { "value": "graduation", "label": "Graduation cap" },
            { "value": "party-hat", "label": "Party hat" },
            { "value": "dandelion-small", "label": "Dandelion" },
            { "value": "mail", "label": "Envelope" },
            { "value": "clock", "label": "Clock" }
          ],
          "default": "cookie"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Tell me your vision" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share your date, colours and theme and I'll take it from there.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature columns",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
