{%- liquid
  assign fallbacks = 'cat-birthdays.webp,placeholder-cat-baby-showers.webp,placeholder-cat-weddings.webp,placeholder-cat-graduations.webp,placeholder-cat-and-more.webp' | split: ','
-%}

<div class="cat-tiles stripe-bg section section--tight">
  <div class="container container--wide">

    {%- if section.settings.heading != blank -%}
      <div class="section-head cat-tiles__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="cat-tiles__list{% if section.settings.mobile_layout == 'scroll' %} cat-tiles__list--scroll{% endif %}"
        style="--tiles-count: {{ section.blocks.size }};"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign idx = forloop.index0 | modulo: 5
            assign fallback = fallbacks[idx]
            assign tile_link = block.settings.link
            if tile_link == blank and block.settings.collection != blank
              assign tile_link = collections[block.settings.collection].url
            endif
          -%}
          <li class="cat-tiles__item" {{ block.shopify_attributes }}>
            <a class="cat-tile" href="{{ tile_link | default: '#' }}">
              <span class="cat-tile__media media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 700
                    | image_tag:
                      widths: '200,300,400,560,700',
                      sizes: '(min-width: 990px) 18vw, (min-width: 750px) 30vw, 62vw',
                      alt: block.settings.label,
                      loading: 'lazy'
                  }}
                {%- elsif block.settings.collection != blank and collections[block.settings.collection].featured_image -%}
                  {{
                    collections[block.settings.collection].featured_image
                    | image_url: width: 700
                    | image_tag:
                      widths: '200,300,400,560,700',
                      sizes: '(min-width: 990px) 18vw, (min-width: 750px) 30vw, 62vw',
                      alt: block.settings.label,
                      loading: 'lazy'
                  }}
                {%- else -%}
                  <img src="{{ fallback | asset_url }}" alt="{{ block.settings.label }}" width="392" height="404" loading="lazy">
                {%- endif -%}
              </span>
              <span class="cat-tile__label">{{ block.settings.label }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="cat-tiles__cta">
        <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn btn--primary">
          {{ section.settings.button_label }}
          {% render 'icon', name: 'arrow-right', class: 'btn__arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "class": "cat-tiles-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading (script)" },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "scroll", "label": "Swipe sideways" },
        { "value": "grid", "label": "Two-column grid" }
      ],
      "default": "scroll"
    },
    { "type": "header", "content": "Button" },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "View gallery"
    },
    { "type": "url", "id": "button_link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square images look best. Falls back to the collection image, then a placeholder."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Birthdays"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Optional. Used for the image and link if none are set below."
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "Birthdays" } },
        { "type": "tile", "settings": { "label": "Baby showers" } },
        { "type": "tile", "settings": { "label": "Weddings" } },
        { "type": "tile", "settings": { "label": "Graduations" } },
        { "type": "tile", "settings": { "label": "And more" } }
      ]
    }
  ]
}
{% endschema %}
