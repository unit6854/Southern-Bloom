<div class="rich-text stripe-bg{% if section.settings.bg == 'alt' %} stripe-bg--alt{% endif %} section section--tight">
  <div class="container container--narrow rich-text__inner" style="text-align: {{ section.settings.align }};">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow rich-text__eyebrow">
        {{ section.settings.eyebrow }}
        {%- if section.settings.show_heart -%}<span class="heart">{% render 'icon', name: 'heart' %}</span>{%- endif -%}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      {%- if section.settings.heading_style == 'script' -%}
        <h2 class="rich-text__heading script">{{ section.settings.heading }}</h2>
      {%- else -%}
        <h2 class="rich-text__heading rich-text__heading--serif display">{{ section.settings.heading }}</h2>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.show_divider -%}
      <div class="divider-dandelion{% if section.settings.align == 'center' %} divider-dandelion--center{% endif %} rich-text__divider">
        {% render 'icon', name: 'dandelion-small' %}
      </div>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="rich-text__body rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: settings.order_form_url }}" class="btn btn--primary rich-text__button">
        {{ section.settings.button_label }}
        {% render 'icon', name: 'arrow-right', class: 'btn__arrow' %}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "rich-text-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "checkbox", "id": "show_heart", "label": "Show heart after label", "default": true },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "script", "label": "Script" },
        { "value": "serif", "label": "Serif" }
      ],
      "default": "script"
    },
    { "type": "checkbox", "id": "show_divider", "label": "Show dandelion divider", "default": false },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Share a little more about your story here.</p>"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "alt", "label": "Alternate background" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
