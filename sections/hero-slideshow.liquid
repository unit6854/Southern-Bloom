{%- liquid
  assign slides = section.blocks
  assign multiple = false
  if slides.size > 1
    assign multiple = true
  endif
  assign layout = section.settings.layout | default: 'overlay'
-%}

<div
  class="hero hero--{{ layout }} stripe-bg{% if section.settings.animate_heading %} hero--animate-heading{% endif %}"
  data-hero
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
  style="
    --hero-media-ratio: {{ section.settings.image_ratio }};
    --hero-min-height: {{ section.settings.min_height }}vw;
    --hero-text-width: {{ section.settings.text_width }}%;
    --hero-focal: {{ section.settings.focal_point }};
    --sweep-duration: {{ section.settings.heading_speed }}s;
  "
>
  <div class="hero__track" data-hero-track>
    {%- for block in slides -%}
      {%- liquid
        if forloop.first
          assign img_loading = 'eager'
          assign img_priority = 'high'
        else
          assign img_loading = 'lazy'
          assign img_priority = 'auto'
        endif
        assign img_alt = block.settings.image_alt | default: block.settings.heading_top | default: shop.name
        assign mobile_img = block.settings.mobile_image | default: block.settings.image
      -%}
      <div
        class="hero__slide{% if forloop.first %} is-active{% endif %}"
        data-hero-slide
        data-index="{{ forloop.index0 }}"
        {% unless forloop.first %}aria-hidden="true"{% endunless %}
        {{ block.shopify_attributes }}
      >
        <div class="hero__media media">
          {%- if block.settings.image != blank -%}
            <picture>
              {%- if mobile_img != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ mobile_img | image_url: width: 750 }} 750w, {{ mobile_img | image_url: width: 1100 }} 1100w"
                  sizes="100vw">
              {%- endif -%}
              <source
                srcset="{{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1800 }} 1800w, {{ block.settings.image | image_url: width: 2400 }} 2400w"
                sizes="100vw">
              <img
                src="{{ block.settings.image | image_url: width: 1800 }}"
                alt="{{ img_alt | escape }}"
                loading="{{ img_loading }}"
                fetchpriority="{{ img_priority }}">
            </picture>
          {%- else -%}
            <picture>
              <source media="(max-width: 749px)" srcset="{{ 'hero-bg-mobile.webp' | asset_url }}">
              <img
                src="{{ 'hero-bg.webp' | asset_url }}"
                alt="{{ img_alt | escape }}"
                width="1584" height="672"
                loading="{{ img_loading }}"
                fetchpriority="{{ img_priority }}">
            </picture>
          {%- endif -%}
        </div>

        {%- if layout == 'overlay' and section.settings.scrim > 0 -%}
          <span class="hero__scrim" aria-hidden="true" style="--hero-scrim: {{ section.settings.scrim | divided_by: 100.0 }};"></span>
        {%- endif -%}

        <div class="hero__content">
          <div class="hero__content-inner">
            {%- if block.settings.eyebrow != blank -%}
              <p class="eyebrow hero__eyebrow">
                {{ block.settings.eyebrow }}
                {%- if block.settings.show_heart -%}
                  <span class="heart">{% render 'icon', name: 'heart' %}</span>
                {%- endif -%}
              </p>
            {%- endif -%}

            {%- if block.settings.heading_top != blank or block.settings.heading_accent != blank -%}
              <p class="hero__heading display">
                {%- if block.settings.heading_top != blank -%}
                  <span class="hero__heading-top">{{ block.settings.heading_top | newline_to_br }}</span>
                {%- endif -%}
                {%- if block.settings.heading_accent != blank -%}
                  <span class="hero__heading-accent">{{ block.settings.heading_accent | newline_to_br }}</span>
                {%- endif -%}
              </p>
            {%- endif -%}

            {%- if block.settings.show_divider -%}
              <div class="divider-dandelion hero__divider">
                {% render 'icon', name: 'dandelion-small' %}
              </div>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="hero__text rte">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              {%- assign btn_link = block.settings.button_link | default: settings.order_form_url -%}
              <a href="{{ btn_link }}" class="btn btn--primary hero__button">
                {{ block.settings.button_label }}
                {% render 'icon', name: 'arrow-right', class: 'btn__arrow' %}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if multiple -%}
    <button class="hero__arrow hero__arrow--prev" type="button" data-hero-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
      {% render 'icon', name: 'chevron-left' %}
    </button>
    <button class="hero__arrow hero__arrow--next" type="button" data-hero-next aria-label="{{ 'accessibility.next_slide' | t }}">
      {% render 'icon', name: 'chevron-right' %}
    </button>

    <div class="hero__dots" role="tablist" aria-label="{{ 'accessibility.slideshow' | t }}">
      {%- for block in slides -%}
        <button
          class="hero__dot{% if forloop.first %} is-active{% endif %}"
          type="button"
          role="tab"
          data-hero-dot
          data-index="{{ forloop.index0 }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="{{ 'accessibility.go_to_slide' | t: index: forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "section",
  "class": "hero-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "overlay", "label": "Full-width photo, text on top" },
        { "value": "split", "label": "Text beside photo" }
      ],
      "default": "overlay",
      "info": "Full-width suits a wide banner with empty space on one side."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Height (desktop)",
      "min": 28,
      "max": 60,
      "step": 1,
      "unit": "vw",
      "default": 42,
      "info": "Relative to screen width. 42 matches the supplied banner."
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text column width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 45
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Keep this part of the photo in view",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Centre" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "right center",
      "info": "Used when the photo has to be cropped to fit."
    },
    {
      "type": "range",
      "id": "scrim",
      "label": "Fade behind the text",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 15,
      "info": "A white wash angled down from the top-left corner, behind the text. Raise it if the photo is busy and the text is hard to read."
    },
    {
      "type": "checkbox",
      "id": "animate_heading",
      "label": "Animate the rose heading colour",
      "default": true,
      "info": "Drifts a gradient of rose tones sideways across the coloured lines."
    },
    {
      "type": "range",
      "id": "heading_speed",
      "label": "Colour drift speed",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "Seconds for one full pass. Higher is slower and calmer."
    },
    { "type": "header", "content": "Slideshow" },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotate slides automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per slide",
      "min": 4,
      "max": 14,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Photo shape (mobile)",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Tall" }
      ],
      "default": "4 / 3"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "A wide banner with clear space on one side works best. Leave empty to use the supplied hero banner."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Photo — mobile",
          "info": "Optional. A taller crop for phones. Falls back to the photo above."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Photo description (for screen readers)"
        },
        { "type": "header", "content": "Text" },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small label above heading",
          "default": "Sweet moments"
        },
        {
          "type": "checkbox",
          "id": "show_heart",
          "label": "Show heart after label",
          "default": true
        },
        {
          "type": "textarea",
          "id": "heading_top",
          "label": "Heading — dark line(s)",
          "default": "Handcrafted"
        },
        {
          "type": "textarea",
          "id": "heading_accent",
          "label": "Heading — rose line(s)",
          "info": "Press Enter for a new line.",
          "default": "with Love,\nMade to Bloom"
        },
        {
          "type": "checkbox",
          "id": "show_divider",
          "label": "Show dandelion divider",
          "default": true
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text",
          "default": "<p>Custom sugar cookies for life's sweetest celebrations.</p>"
        },
        { "type": "header", "content": "Button" },
        {
          "type": "text",
          "id": "button_label",
          "label": "Label",
          "default": "Order custom cookies"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link",
          "info": "Leave empty to use the custom order form URL from Theme settings."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
