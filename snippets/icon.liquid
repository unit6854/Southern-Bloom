  {%- when 'rings' -%}
    <svg class="{{ cls }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
