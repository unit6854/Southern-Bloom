{%- comment -%}
  Renders an inline SVG icon.

  Usage: {% render 'icon', name: 'cake', class: 'occasion-icon' %}

  All icons inherit `currentColor` so they can be recoloured with CSS.
  Line icons use a 48x48 viewBox; UI icons use 24x24.
{%- endcomment -%}

{%- liquid
  assign cls = class | default: ''
  assign sw = stroke | default: 1.4
-%}

{%- case name -%}

  {%- comment -%} ---------- Occasion line icons (48 x 48) ---------- {%- endcomment -%}

  {%- when 'cake' -%}
    <svg class="{{ cls }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M24 7.2c1.6 1.3 2.4 2.4 2.4 3.4a2.4 2.4 0 0 1-4.8 0c0-1 .8-2.1 2.4-3.4Z"/>
      <path d="M24 13.6v3.1"/>
      <rect x="15" y="16.7" width="18" height="6.6" rx="1.4"/>
      <path d="M15 20h18"/>
      <rect x="11" y="23.3" width="26" height="7.2" rx="1.4"/>
      <path d="M11 26.8h26"/>
      <path d="M24 30.5v6.8"/>
      <path d="M17.5 41.2c0-2.6 2.9-3.9 6.5-3.9s6.5 1.3 6.5 3.9"/>
      <path d="M13.5 41.2h21"/>
    </svg>

  {%- when 'onesie' -%}
