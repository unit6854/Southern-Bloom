{%- comment -%}
  Renders the circular social buttons.
  Usage: {% render 'social-icons', class: 'footer__social' %}
{%- endcomment -%}

{%- liquid
  assign has_social = false
  if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_pinterest_link != blank or settings.social_tiktok_link != blank
    assign has_social = true
  endif
-%}

{%- if has_social -%}
  <ul class="social-icons {{ class }}">
    {%- if settings.social_facebook_link != blank -%}
      <li>
        <a class="social-icons__link" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
          {% render 'icon', name: 'facebook' %}
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_instagram_link != blank -%}
      <li>
        <a class="social-icons__link" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
          {% render 'icon', name: 'instagram' %}
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_pinterest_link != blank -%}
      <li>
        <a class="social-icons__link" href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" aria-label="Pinterest">
          {% render 'icon', name: 'pinterest' %}
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_tiktok_link != blank -%}
      <li>
        <a class="social-icons__link" href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">
          {% render 'icon', name: 'tiktok' %}
        </a>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
