<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_announcement }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>{{ shop.name }}</title>
    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- liquid
      assign f_script  = settings.font_script  | default: 'Great Vibes'
      assign f_heading = settings.font_heading | default: 'Cormorant Garamond'
      assign f_body    = settings.font_body    | default: 'Montserrat'
      assign q_script  = f_script  | replace: ' ', '+'
      assign q_heading = f_heading | replace: ' ', '+'
      assign q_body    = f_body    | replace: ' ', '+'
    -%}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ q_script }}&family={{ q_heading }}:wght@400;500;600&family={{ q_body }}:wght@400;600;700&display=swap">

    <style>
      :root {
        --c-rose: {{ settings.color_rose }};
        --c-rose-deep: {{ settings.color_rose_deep }};
        --c-rose-soft: {{ settings.color_rose_soft }};
        --c-announce: {{ settings.color_announcement }};
        --c-sage: {{ settings.color_sage }};
        --c-bg: {{ settings.color_bg }};
        --c-bg-alt: {{ settings.color_bg_alt }};
        --c-ink: {{ settings.color_ink }};
        --c-text: {{ settings.color_text }};
        --c-text-soft: {{ settings.color_text_soft }};
        --c-line: {{ settings.color_line }};
        --font-script: '{{ f_script }}', cursive;
        --font-heading: '{{ f_heading }}', Georgia, serif;
        --font-body: '{{ f_body }}', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
        --body-size: {{ settings.body_size | default: 16 }}px;
        --page-width: {{ settings.page_width | default: 1280 }}px;
        --btn-radius: {{ settings.btn_radius | default: 2 }}px;
        --card-radius: {{ settings.card_radius | default: 2 }}px;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="template-password stripe-bg">
    <main role="main">{{ content_for_layout }}</main>
  </body>
</html>
