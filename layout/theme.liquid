<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_announcement }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- liquid
      assign meta_desc = page_description | default: settings.meta_description
    -%}
    {%- if meta_desc != blank -%}
      <meta name="description" content="{{ meta_desc | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- comment -%} ---- Fonts ---- {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- liquid
      assign f_script  = settings.font_script  | default: 'Great Vibes'
      assign f_heading = settings.font_heading | default: 'Cormorant Garamond'
      assign f_body    = settings.font_body    | default: 'Montserrat'
      assign q_script  = f_script  | replace: ' ', '+'
      assign q_heading = f_heading | replace: ' ', '+'
      assign q_body    = f_body    | replace: ' ', '+'
    -%}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family={{ q_script }}&family={{ q_heading }}:ital,wght@0,400;0,500;0,600;0,700;1,400&family={{ q_body }}:wght@300;400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ q_script }}&family={{ q_heading }}:wght@400;500;600;700&family={{ q_body }}:wght@300;400;500;600;700&display=swap">
    </noscript>

    {%- comment -%} ---- Design tokens from theme settings ---- {%- endcomment -%}
    <style>
      :root {
        --c-rose:        {{ settings.color_rose }};
        --c-rose-deep:   {{ settings.color_rose_deep }};
        --c-rose-soft:   {{ settings.color_rose_soft }};
        --c-announce:    {{ settings.color_announcement }};
        --c-sage:        {{ settings.color_sage }};

        --c-bg:          {{ settings.color_bg }};
        --c-bg-alt:      {{ settings.color_bg_alt }};

        --c-ink:         {{ settings.color_ink }};
        --c-text:        {{ settings.color_text }};
        --c-text-soft:   {{ settings.color_text_soft }};
        --c-line:        {{ settings.color_line }};

        --c-rose-rgb:    {{ settings.color_rose.red }}, {{ settings.color_rose.green }}, {{ settings.color_rose.blue }};

        --font-script:  '{{ f_script }}', 'Brush Script MT', cursive;
        --font-heading: '{{ f_heading }}', Georgia, 'Times New Roman', serif;
        --font-body:    '{{ f_body }}', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;

        --body-size:   {{ settings.body_size | default: 16 }}px;
        --page-width:  {{ settings.page_width | default: 1280 }}px;
        --btn-radius:  {{ settings.btn_radius | default: 2 }}px;
        --card-radius: {{ settings.card_radius | default: 2 }}px;
      }
      {%- unless settings.enable_stripe_texture -%}
      .stripe-bg { background-image: none; }
      {%- endunless -%}
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}

    {%- if settings.enable_custom_cursor -%}
      {%- comment -%}
        Must come AFTER the stylesheets: base.css sets `cursor: pointer` on
        buttons and .btn, and at equal specificity the later rule wins.
        It lives in Liquid rather than base.css because the images need
        asset_url. Hotspot (16 10) is the centre of the seed head.
        Fine pointers only — a cursor is meaningless on touch, and this way
        phones never download the images.
      {%- endcomment -%}
      <style>
        @media (hover: hover) and (pointer: fine) {
          body {
            cursor: url("{{ 'cursor-bloom.png' | asset_url }}") 16 10, auto;
          }
          a, button, summary, label[for], [role="button"], [role="tab"],
          .btn, .cat-tile, .gallery-item, .occasions__link, select {
            cursor: url("{{ 'cursor-bloom-link.png' | asset_url }}") 16 10, pointer;
          }
          /* Text entry keeps a real caret — a flower here would be unusable. */
          input:not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]):not([type="reset"]),
          textarea {
            cursor: text;
          }
          [disabled], .btn[disabled], button[disabled] { cursor: not-allowed; }
        }
      </style>
    {%- endif -%}
    {{ 'pages.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }} stripe-bg">
    <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>
  </body>
</html>
